# Supabase: public by design (RLS is the boundary). Client + server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: server-only. Acts as service_role and skips RLS.
SUPABASE_SECRET_KEY=

# Clerk: public (client).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk: server-only.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI: server-only.
OPENAI_API_KEY=

# Arcjet: server-only.
ARCJET_KEY=

# PostHog: public (client + server).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# App URL: public (client + server).
NEXT_PUBLIC_APP_URL=

# Landing widget key: server-only, read at request time (a public key, but per-environment config).
LANDING_WIDGET_KEY=
