{
  "name": "@askwell/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:widget": "pnpm -C ../widget build && node -e \"const f=require('node:fs');f.mkdirSync('public',{recursive:true});f.copyFileSync('../widget/dist/widget.js','public/widget.js')\"",
    "predev": "pnpm build:widget",
    "prebuild": "pnpm build:widget",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@askwell/db": "workspace:*",
    "@askwell/shared": "workspace:*",
    "@clerk/nextjs": "^7.10.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.0"
  }
}
